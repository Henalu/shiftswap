# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this in client bundles or commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_NAME=ShiftSwap

# Billing
BILLING_ENABLED=false
BILLING_MODE=user
BILLING_ENFORCEMENT=off
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUNDER_20_MONTHLY=
STRIPE_PRICE_FOUNDER_20_ANNUAL=
STRIPE_PRICE_EARLY_70_MONTHLY=
STRIPE_PRICE_EARLY_70_ANNUAL=
STRIPE_PRICE_GROWTH_170_MONTHLY=
STRIPE_PRICE_GROWTH_170_ANNUAL=
STRIPE_PRICE_LAUNCH_200_MONTHLY=
STRIPE_PRICE_LAUNCH_200_ANNUAL=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=

# Anti-bot
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUGGESTIONS_TO_EMAIL=

# E2E / smoke
E2E_BASE_URL=
E2E_PORT=3001
# Default keeps the historical ShiftSwap behavior: Playwright starts a dev server
# when E2E_BASE_URL is empty. Set E2E_START_SERVER=0 to use an already running app.
E2E_START_SERVER=
E2E_MEMBER_EMAIL=
E2E_MEMBER_PASSWORD=
# Preferred scoped admin credentials. E2E_ADMIN_* is kept as a legacy alias.
E2E_DEPARTMENT_ADMIN_EMAIL=
E2E_DEPARTMENT_ADMIN_PASSWORD=
E2E_HR_ADMIN_EMAIL=
E2E_HR_ADMIN_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_SUPER_ADMIN_EMAIL=
E2E_SUPER_ADMIN_PASSWORD=
# Optional: member that is not a participant in E2E_EXCHANGE_ID for negative PDF smokes.
E2E_UNRELATED_EMAIL=
E2E_UNRELATED_PASSWORD=
E2E_EXCHANGE_ID=
